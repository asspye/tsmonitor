[Unit]
Description=TSMonitor - MPEG-TS Stream Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asspye
Group=asspye
WorkingDirectory=/home/asspye/tsmonitor
ExecStart=/home/asspye/tsmonitor/bin/tsmonitor /home/asspye/tsmonitor/config.yaml
# Some multicast streams use UDP ports < 1024 (e.g. 238.5.5.4:554): allow tsp to bind them without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Creates /var/log/tsmonitor owned by the service user (SCTE-35 event log)
LogsDirectory=tsmonitor
Restart=always
RestartSec=5
# One tsp per stream: allow enough processes and file descriptors
LimitNOFILE=65536
TasksMax=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
