          "gridPos": {
            "x": 0,
            "y": 20,
            "w": 24,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              },
              "editorMode": "code",
              "expr": "ts_stream_status{job=\"tsmonitor\"} == 0",
              "refId": "A",
              "legendFormat": "__auto",
              "range": false,
              "instant": true,
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "align": "auto",
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "stream"
                },
                "properties": [
                  {
                    "id": "links",
                    "value": [
                      {
                        "title": "Открыть поток",
                        "url": "/d/ts-stream-details?var-stream=${__data.fields.stream}&var-description=${__data.fields.description}&${__url_time_range}"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "footer": {
              "show": false
            }
          },
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "instance": true,
                  "job": true,
                  "Value": true
                },
                "renameByName": {
                  "description": "Название канала",
                  "stream": "IP:Port"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Проблемы",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Проблемные потоки за час",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (stream, description) (increase(ts_stream_cc_errors_total{job=\"tsmonitor\"}[1h]))",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (stream, description) (increase(ts_stream_transport_errors_total{job=\"tsmonitor\"}[1h]))",
          "refId": "B",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (stream, description) (increase(ts_stream_pcr_jitter_exceeded_total{job=\"tsmonitor\"}[1h]))",
          "refId": "C",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (stream, description) (ts_stream_iat_seconds{job=\"tsmonitor\",stat=\"stddev\"})",
          "refId": "D",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (stream, description) (ts_stream_iat_seconds{job=\"tsmonitor\",stat=\"max\"})",
          "refId": "E",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "stream"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Открыть поток",
                    "url": "/d/ts-stream-details?var-stream=${__data.fields.stream}&var-description=${__data.fields.description}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CC"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
