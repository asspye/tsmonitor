                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TEI"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PCR > 5 мс"
